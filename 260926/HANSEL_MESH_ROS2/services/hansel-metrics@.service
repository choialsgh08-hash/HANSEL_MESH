[Unit]
Description=HANSEL mesh metrics agent (%i)
Requires=hansel-mesh@%i.service
After=hansel-mesh@%i.service
PartOf=hansel-mesh@%i.service

[Service]
Type=simple
User=root
WorkingDirectory=@HANSEL_REPO_DIR@
ExecStart=@HANSEL_REPO_DIR@/scripts/start_metrics_agent.sh %i
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
