[Unit]
Description=HANSEL motor control server (%i)
Requires=hansel-mesh@%i.service
After=hansel-mesh@%i.service
PartOf=hansel-mesh@%i.service

[Service]
Type=simple
User=root
StateDirectory=hansel-mesh
StateDirectoryMode=0700
WorkingDirectory=/home/hansel/HANSEL_MESH
EnvironmentFile=/etc/hansel-mesh/control.env
ExecStart=/home/hansel/HANSEL_MESH/scripts/start_control_server.sh %i
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
