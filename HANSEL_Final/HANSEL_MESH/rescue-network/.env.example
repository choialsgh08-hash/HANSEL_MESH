# Rescue-network node configuration.
# Copy to `.env` (never commit .env) and adjust per node.

# ---- Node identity / role -------------------------------------------------
# field | relay | receiver
NODE_ROLE=field
NODE_ID=node-01

# ---- Victim AP (field node; configured by scripts/configure-ap.sh) --------
AP_INTERFACE=wlan0
AP_ADDRESS=192.168.10.1/24

# ---- Rescue-request delivery (Phase 2 — forwarder/receiver) ---------------
# Receiver's bat0 IP on the EXISTING HANSEL mesh (base node = 192.168.50.1).
# rescue-network does not configure the mesh; use the repo's mesh scripts.
RECEIVER_URL=http://192.168.50.1:8080
RESCUE_SHARED_TOKEN=change-me

# ---- Web server -----------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=80

# ---- Storage --------------------------------------------------------------
# Directory that must be writable by the service user. The SQLite file lives
# here (field.db / receiver.db depending on role).
DATA_DIR=./data
