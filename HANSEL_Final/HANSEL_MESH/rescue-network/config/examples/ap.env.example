# Victim-AP configuration for scripts/configure-ap.sh (Phase 4).
# Copy to /etc/rescue-network/ap.env and edit. Do NOT commit a real file with a
# passphrase.
#
# The interface is NOT hardcoded anywhere — set it from `detect-network.sh`
# output. On a field Pi the AP is usually the *internal* Wi-Fi (brcmfmac); the
# USB dongle is reserved for the B.A.T.M.A.N. mesh (Phase 5).

# Interface that will host the victim AP (e.g. wlan0). REQUIRED.
AP_INTERFACE=wlan0

# SSID victims connect to.
AP_SSID=Rescue-Network

# Regulatory country code (REQUIRED for a legal AP; e.g. KR, US, GB).
AP_COUNTRY=KR

# Band + channel. AP_BAND: 2.4 or 5. 2.4GHz ch 1/6/11 are safest.
AP_BAND=2.4
AP_CHANNEL=6

# AP IP (CIDR) and the address victims type into the browser.
AP_ADDRESS=192.168.10.1/24

# DHCP pool handed to phones.
DHCP_RANGE_START=192.168.10.100
DHCP_RANGE_END=192.168.10.200
DHCP_LEASE=12h

# WPA2 security. AP_SECURITY: wpa2 (recommended) or open.
# If wpa2, AP_PASSPHRASE must be 8..63 chars.
AP_SECURITY=wpa2
AP_PASSPHRASE=change-this-passphrase

# Captive portal (Phase 6): 1 = wild-card DNS so phones auto-pop the form.
# Must be paired with the app running with CAPTIVE_PORTAL=1. Default 0.
AP_CAPTIVE=0

# System paths the AP configs are installed to (Debian/Raspberry Pi OS defaults).
HOSTAPD_CONF=/etc/hostapd/hostapd.conf
DNSMASQ_CONF=/etc/dnsmasq.d/rescue-ap.conf
