# Measured quality thresholds for HANSEL_MESH.
#
# Fill these in from monitor/calibrate_thresholds.py output after a real
# hardware measurement run, copy this file to configs/quality.env, then launch:
#   python3 monitor/dashboard.py --quality-config configs/quality.env
# or export HANSEL_QUALITY_CONFIG=configs/quality.env before starting.
#
# Any key you omit keeps the built-in default. The values below are the current
# PRE-HARDWARE estimates - replace them with measured numbers once available.

# Radio link health (weakest direct link)
SIGNAL_WARN_DBM=-75
SIGNAL_DANGER_DBM=-82
INACTIVE_WARN_MS=1500
INACTIVE_DANGER_MS=3000

# End-to-end network
RTT_WARN_MS=120
RTT_DANGER_MS=180
LOSS_WARN_PCT=5
LOSS_DANGER_PCT=10

# BATMAN path quality (TQ 0-255; lower is worse)
TQ_WARN=200
TQ_DANGER=180
