# Camera autostart is intentionally disabled until this file is reviewed.
# Copy to /etc/hansel-mesh/camera.env on the head Pi, set the operator PC
# destination, then change CAMERA_ENABLED to yes.
CAMERA_ENABLED="no"
CAMERA_DEST_IP=""
CAMERA_DEST_PORT="5600"
CAMERA_TRANSPORT="rtp"
PROFILE="medium"
