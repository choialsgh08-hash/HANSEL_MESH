# Head-side IWRL6432 radar service configuration.
# Copy to /etc/hansel-mesh/radar-head.env and adjust the hardware identity.

RADAR_BIND=192.168.50.10
RADAR_HTTP_PORT=8081
RADAR_SERIAL_PORT=
RADAR_XDS_SERIAL=
RADAR_PROFILE=/home/hansel/HANSEL_MESH/configs/radar/iwrl6432_2p5d_operator_nearwall_5hz.cfg
RADAR_CALIBRATION=/home/hansel/HANSEL_MESH/configs/radar/calibrations/head-nearwall-16az-adc-5hz.json
RADAR_OUTPUT_ROOT=/home/hansel/HANSEL_MESH/runtime/radar
