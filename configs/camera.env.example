# Camera autostart is intentionally disabled until this file is reviewed.
# Copy to /etc/hansel-mesh/camera.env on the head Pi, set the operator PC
# destination, then change CAMERA_ENABLED to yes.
CAMERA_ENABLED="no"
CAMERA_DEST_IP=""
CAMERA_DEST_PORT="5600"
CAMERA_TRANSPORT="rtp"
PROFILE="medium"
# Keyframe interval (GOP) in FRAMES between H.264 keyframes.
# Lower = faster video recovery after a mesh reconnect (stutter cause B),
# at the cost of higher bitrate. At 15 fps: 15 = one keyframe/second (the
# default), 8 ~= every 0.5s. Leave empty to default to the framerate.
# Set this from a measurement run (monitor/calibrate_thresholds.py) that shows
# keyframe-wait dominates the reconnect outage. See docs/reconnect_tuning.md.
CAMERA_INTRA=""
