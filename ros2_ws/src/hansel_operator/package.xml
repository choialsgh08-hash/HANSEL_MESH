<?xml version="1.0"?>
<package format="3">
  <name>hansel_operator</name>
  <version>0.2.0</version>
  <description>HANSEL operator input, command routing, detach coordination, and RQT UI.</description>
  <maintainer email="hansel@example.com">HANSEL Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>hansel_interfaces</depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>

