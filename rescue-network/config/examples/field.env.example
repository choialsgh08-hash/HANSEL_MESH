# systemd EnvironmentFile for a FIELD node.
# Install to /etc/rescue-network/field.env and: chmod 600, chown rescue:rescue.
# (Contains the shared secret — keep it out of git and world-unreadable.)

NODE_ROLE=field
NODE_ID=node-01

# Web server bind (uvicorn). Field form is served on the AP address :80.
WEB_HOST=0.0.0.0
WEB_PORT=80

# Writable data dir. Must match the systemd StateDirectory (/var/lib/rescue-network).
DATA_DIR=/var/lib/rescue-network

# Receiver's bat0 IP on the EXISTING HANSEL mesh (base node = 192.168.50.1).
# Bring the mesh up with the repo's scripts/*mesh*.sh; rescue does not set it up.
RECEIVER_URL=http://192.168.50.1:8080

# Shared token — MUST be identical on field + receiver. Change from the default!
RESCUE_SHARED_TOKEN=change-me-to-a-strong-shared-secret

# --- Optional forwarder tuning (defaults shown) ---
# FORWARDER_POLL_INTERVAL_SECONDS=2.0
# DELIVERY_TIMEOUT_SECONDS=10.0
# FORWARDER_BATCH_SIZE=20
# STALE_SENDING_SECONDS=120.0
