# Wired rescue-laptop gateway for a RECEIVER node (Phase 6).
# Copy to /etc/rescue-network/gateway.env and edit. Lets the rescue team plug a
# laptop into the receiver Pi's Ethernet and reach the dashboard, keeping the
# laptop off the mesh radios.

# Wired interface the laptop plugs into (from detect-network.sh). Not hardcoded.
LAN_INTERFACE=eth0

# Static IP the receiver serves on that wire (the laptop's gateway).
LAN_ADDRESS=10.20.0.1/24

# DHCP pool handed to the laptop.
LAN_DHCP_START=10.20.0.50
LAN_DHCP_END=10.20.0.100
LAN_DHCP_LEASE=12h

# 1 = also ROUTE the laptop into the mesh (enables IP forwarding on THIS node
# only, backed up + reversible). 0 = laptop reaches only the receiver itself
# (dashboard), which is all most deployments need. Default 0.
GATEWAY_FORWARD=0
# Mesh subnet reachable when forwarding is on (informational / routing).
MESH_SUBNET=10.10.0.0/24

# Install paths.
LAN_DNSMASQ_CONF=/etc/dnsmasq.d/rescue-lan.conf
SYSCTL_CONF=/etc/sysctl.d/99-rescue-gateway.conf
