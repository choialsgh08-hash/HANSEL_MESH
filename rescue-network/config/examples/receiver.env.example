# systemd EnvironmentFile for a RECEIVER (rescue-team) node.
# Install to /etc/rescue-network/receiver.env and: chmod 600, chown rescue:rescue.

NODE_ROLE=receiver
NODE_ID=receiver-01

# Receiver listens on the mesh IP/port that field forwarders target.
WEB_HOST=0.0.0.0
WEB_PORT=8080

DATA_DIR=/var/lib/rescue-network

# Shared token — MUST match every field node. Change from the default!
RESCUE_SHARED_TOKEN=change-me-to-a-strong-shared-secret
