# systemd EnvironmentFile for a RELAY node.
# A relay runs B.A.T.M.A.N.-adv only (no web app / no forwarder) — those network
# services arrive in Phase 5. This file exists so the role is configurable now.
# Install to /etc/rescue-network/relay.env.

NODE_ROLE=relay
NODE_ID=relay-01

# Mesh interface + bat0 address (used by the Phase 5 network bring-up scripts).
MESH_INTERFACE=wlan1
BAT_ADDRESS=10.10.0.11/24
# 80211s | ibss
MESH_BACKEND=80211s
