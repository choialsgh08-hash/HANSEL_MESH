# systemd EnvironmentFile for a RELAY node.
#
# A relay only forwards B.A.T.M.A.N.-adv Layer-2 frames — it runs NO rescue
# application and NO forwarder. The mesh itself is brought up by the existing
# HANSEL scripts (scripts/*mesh*.sh, configs/*.env), NOT by rescue-network.
#
# This file exists only so the role is explicit; rescue-network installs no
# services for a relay node.

NODE_ROLE=relay
NODE_ID=relay-01
