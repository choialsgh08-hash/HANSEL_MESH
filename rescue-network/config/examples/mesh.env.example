# B.A.T.M.A.N.-adv mesh configuration for scripts/configure-batman.sh (Phase 5).
# Copy to /etc/rescue-network/mesh.env and edit per node.
#
# IMPORTANT: bat0 is the ONLY interface that gets an IP address. The underlying
# radio (MESH_INTERFACE) carries the mesh but is never given a normal IP.

# USB Wi-Fi dongle that carries the mesh (NOT the internal Wi-Fi used for the AP).
# Set from detect-network.sh output — never assume a name.
MESH_INTERFACE=wlan1

# Mesh backend: 80211s (mesh point) or ibss (ad-hoc). The dongle MUST support the
# chosen mode; configure-batman.sh checks `iw` and refuses an unsupported one.
MESH_BACKEND=80211s

# Mesh identity (802.11s mesh id / IBSS SSID). Identical on every node.
MESH_ID=rescue-mesh

# Regulatory country + radio frequency (MHz). 2412 = ch1, 2437 = ch6, 2462 = ch11.
MESH_COUNTRY=KR
MESH_FREQ=2412

# For IBSS only: fixing the cell BSSID forces all nodes into the SAME cell.
# Leave blank for 80211s. Example: 02:12:34:56:78:9A
MESH_BSSID=

# batman-adv adds ~30 bytes of overhead; give the radio a larger MTU to avoid
# fragmenting bat0's 1500-byte frames.
MESH_MTU=1560

# bat0 address (CIDR), UNIQUE per node. Convention: receiver = 10.10.0.254.
BAT_ADDRESS=10.10.0.1/24

# Optional peer bat0 IP for verify-network.sh to ping (e.g. the receiver).
BAT_PEER=10.10.0.254

# Persistent module load file written on --apply.
BATMAN_MODULES_LOAD=/etc/modules-load.d/batman-adv.conf
