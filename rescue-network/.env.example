# Rescue-network node configuration.
# Copy to `.env` (never commit .env) and adjust per node.

# ---- Node identity / role -------------------------------------------------
# field | relay | receiver
NODE_ROLE=field
NODE_ID=node-01

# ---- Wireless interfaces (Phase 4/5 — not used in Phase 1) ----------------
AP_INTERFACE=wlan0
MESH_INTERFACE=wlan1
AP_ADDRESS=192.168.10.1/24
BAT_ADDRESS=10.10.0.1/24
# 80211s | ibss
MESH_BACKEND=80211s

# ---- Rescue-request delivery (Phase 2 — forwarder/receiver) ---------------
RECEIVER_URL=http://10.10.0.254:8080
RESCUE_SHARED_TOKEN=change-me

# ---- Web server -----------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=80

# ---- Storage --------------------------------------------------------------
# Directory that must be writable by the service user. The SQLite file lives
# here (field.db / receiver.db depending on role).
DATA_DIR=./data
